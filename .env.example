# Copy this file to .env and adjust as needed.
# docker-compose.yml already overrides DATABASE_URL / CORS_ORIGINS / etc for
# the containerized backend, so this file mostly matters when running the
# backend directly with `uvicorn` on your host machine.

ENV=development

# AWS serverless incident intake API. This is safe to expose: it is an API
# endpoint, not a secret or an AWS API key. Vite embeds it at build time.
VITE_AWS_INTAKE_API_URL=https://4jz5lyekei.execute-api.ap-south-2.amazonaws.com/dev

# --- Database ---
# Local: Postgres via docker-compose (stands in for DynamoDB later).
DATABASE_URL=postgresql+psycopg2://cloudrelief:cloudrelief@localhost:5432/cloudrelief

# --- Auth / JWT ---
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# =========================================================================
# CLOUD PROVIDER SWITCHES
# Flip these one at a time as each real AWS/Oracle service is wired in.
# See README.md "Cloud Migration Guide" for exactly which file to add per
# switch. Everything defaults to the local/mock implementation.
# =========================================================================

# local  -> LocalStorageService (filesystem, stands in for S3)
# s3     -> S3StorageService (not yet implemented; add app/services/storage/s3.py)
STORAGE_PROVIDER=local

# local   -> LocalAuthService (JWT + bcrypt, stands in for Cognito)
# cognito -> CognitoAuthService (not yet implemented; add app/services/auth/cognito.py)
AUTH_PROVIDER=local

# console -> ConsoleNotifyService (logs + `alerts` table, stands in for SNS)
# sns     -> SnsNotifyService (not yet implemented; add app/services/notify/sns.py)
NOTIFY_PROVIDER=console

# mock         -> MockClassifierService (random label/confidence, stands in for Rekognition)
# rekognition  -> RekognitionClassifierService (not yet implemented; add app/services/classifier/rekognition.py)
CLASSIFIER_PROVIDER=mock

# --- Local storage (only used when STORAGE_PROVIDER=local) ---
LOCAL_STORAGE_DIR=./backend/storage/uploads
FILES_BASE_URL=http://localhost:8000/files

# --- CORS ---
CORS_ORIGINS=http://localhost:5174

# --- Severity scoring constants (see backend/app/core/severity.py) ---
URGENCY_WEIGHT=0.2
DENSITY_CAP=5
DENSITY_WEIGHT=1.0
ALERT_THRESHOLD=0.6
DENSITY_RADIUS_KM=5
DENSITY_WINDOW_HOURS=24

# =========================================================================
# Future AWS / Oracle credentials (uncomment and fill in when you flip a
# provider switch above; not required for local/mock providers).
# =========================================================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# SNS_TOPIC_ARN=
# REKOGNITION_MIN_CONFIDENCE=60
